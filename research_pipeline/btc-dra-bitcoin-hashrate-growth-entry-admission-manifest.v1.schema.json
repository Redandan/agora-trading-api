{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/btc-dra-bitcoin-hashrate-growth-entry-admission-manifest.v1.schema.json",
  "title": "BTC DRA Bitcoin hash-rate growth entry-admission manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization", "availability", "bindings", "dataset", "document_type", "economics", "experiment_id", "factor", "gate_set", "oos_access", "parent_strategy", "schema_version", "selection_cutoff", "source", "windows"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "BTC_DRA_BITCOIN_HASHRATE_GROWTH_ENTRY_ADMISSION_MANIFEST_V1"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "experiment_id": {"const": "dra-bitcoin-hashrate-growth-entry-admission-historical-v1"},
    "parent_strategy": {"const": "BTC_DRA_V1"},
    "gate_set": {"const": "BTC_DRA_CFTC_TFF_HISTORICAL_ENTRY_ADMISSION_GATES_V1"},
    "oos_access": {"const": "DENY"},
    "selection_cutoff": {"const": "2025-01-01T00:00:00"},
    "dataset": {"const": {"canonical_sha256": "e436a5a2b093365886464dd3e471cc5cd55c54bd2c06ceaa898ac218c45436dd", "rows": 52608}},
    "economics": {"const": {"fee_rate": "0.0010", "initial_equity_usdt": "250", "slippage_rate": "0.0005", "slot_capacity_usdt": "240"}},
    "factor": {
      "const": {
        "admission_rule": "ADMIT_PARENT_SIGNAL_ONLY_WHEN_CURRENT_28D_MEAN_HASHRATE_GT_IMMEDIATELY_PRECEDING_28D_MEAN",
        "factor_identity": "COIN_METRICS_BTC_HASHRATE_STRICT_POSITIVE_ADJACENT_28D_GROWTH_168H_V1",
        "formula": "current_28d_mean_hashrate-prior_nonoverlapping_28d_mean_hashrate",
        "negative_action": "HOLD_CASH",
        "positive_action": "ADMIT",
        "series_id": "HashRate",
        "zero_action": "HOLD_CASH"
      }
    },
    "availability": {
      "const": {
        "eligible_time": "WEEK_ENDING_SUNDAY_PLUS_3_CALENDAR_DAYS_AT_00_00_UTC",
        "factor_valid_hours": 168,
        "non_sunday_action": "REJECT_SOURCE",
        "publication_lag_calendar_days": 3,
        "window_days": 28
      }
    },
    "source": {
      "const": {
        "first_date": "2018-01-01",
        "last_date": "2024-12-31",
        "metric": "HashRate",
        "normalized_bytes": 109229,
        "present_vintage": true,
        "publisher": "Coin Metrics Community API",
        "rows": 2557,
        "weekly_aggregation": "SEVEN_COMPLETE_DAYS_MONDAY_THROUGH_SUNDAY"
      }
    },
    "windows": {
      "const": {
        "annual_folds": ["2020", "2021", "2022", "2023", "2024"],
        "design": {"end_exclusive": "2023-01-01T00:00:00", "start_inclusive": "2020-01-01T00:00:00"},
        "outcome_horizon_hours": 168,
        "validation": {"end_exclusive": "2025-01-01T00:00:00", "start_inclusive": "2023-01-01T00:00:00"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_runner", "capacity_runner", "hypothesis", "manifest_schema", "normalized_source", "primary_prior", "raw_source_response", "reused_economic_runner", "runner", "source_bundle", "source_metadata", "source_probe"],
      "properties": {
        "base_runner": {"$ref": "#/$defs/binding"},
        "capacity_runner": {"$ref": "#/$defs/binding"},
        "hypothesis": {"$ref": "#/$defs/binding"},
        "manifest_schema": {"$ref": "#/$defs/binding"},
        "normalized_source": {"$ref": "#/$defs/binding"},
        "primary_prior": {"$ref": "#/$defs/binding"},
        "raw_source_response": {"$ref": "#/$defs/binding"},
        "reused_economic_runner": {"$ref": "#/$defs/binding"},
        "runner": {"$ref": "#/$defs/binding"},
        "source_bundle": {"$ref": "#/$defs/binding"},
        "source_metadata": {"$ref": "#/$defs/binding"},
        "source_probe": {"$ref": "#/$defs/binding"}
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
