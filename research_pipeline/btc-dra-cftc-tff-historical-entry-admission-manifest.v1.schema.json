{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/btc-dra-cftc-tff-historical-entry-admission-manifest.v1.schema.json",
  "title": "BTC DRA CFTC TFF historical entry-admission manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["archives", "authorization", "availability", "bindings", "dataset", "document_type", "economics", "experiment_id", "factor", "gate_set", "oos_access", "parent_strategy", "schema_version", "selection_cutoff", "windows"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "BTC_DRA_CFTC_TFF_HISTORICAL_ENTRY_ADMISSION_MANIFEST_V1"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "experiment_id": {"const": "cftc-tff-dra-entry-admission-historical-v1"},
    "parent_strategy": {"const": "BTC_DRA_V1"},
    "gate_set": {"const": "BTC_DRA_CFTC_TFF_HISTORICAL_ENTRY_ADMISSION_GATES_V1"},
    "oos_access": {"const": "DENY"},
    "selection_cutoff": {"const": "2025-01-01T00:00:00"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_sha256", "rows"],
      "properties": {
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "economics": {
      "const": {
        "fee_rate": "0.0010",
        "initial_equity_usdt": "250",
        "slippage_rate": "0.0005",
        "slot_capacity_usdt": "240"
      }
    },
    "factor": {
      "const": {
        "admission_rule": "ADMIT_PARENT_SIGNAL_ONLY_WHEN_FACTOR_DELTA_GT_ZERO",
        "factor_identity": "CFTC_TFF_LEV_MONEY_NET_PCT_OI_WEEKLY_DELTA_CONTINUATION_168H_V1",
        "formula": "(current_long_pct-current_short_pct)-(prior_long_pct-prior_short_pct)",
        "negative_action": "HOLD_CASH",
        "positive_action": "ADMIT",
        "zero_action": "HOLD_CASH"
      }
    },
    "availability": {
      "const": {
        "eligible_time": "REPORT_DATE_PLUS_14_CALENDAR_DAYS_AT_00_00_UTC",
        "exact_predecessor_days": 7,
        "factor_valid_hours": 168,
        "ion_exclusion": {
          "end_inclusive": "2023-03-14",
          "reason": "CFTC_2023_ION_DELAYED_PUBLICATION",
          "start_inclusive": "2023-01-31"
        },
        "non_tuesday_action": "EXCLUDE",
        "report_lag_calendar_days": 14
      }
    },
    "windows": {
      "const": {
        "annual_folds": ["2020", "2021", "2022", "2023", "2024"],
        "design": {"end_exclusive": "2023-01-01T00:00:00", "start_inclusive": "2020-01-01T00:00:00"},
        "outcome_horizon_hours": 168,
        "validation": {"end_exclusive": "2025-01-01T00:00:00", "start_inclusive": "2023-01-01T00:00:00"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_runner", "capacity_runner", "factor_contract", "factor_evaluator", "manifest_schema", "runner", "source_contract", "source_field_definition"],
      "properties": {
        "base_runner": {"$ref": "#/$defs/binding"},
        "capacity_runner": {"$ref": "#/$defs/binding"},
        "factor_contract": {"$ref": "#/$defs/binding"},
        "factor_evaluator": {"$ref": "#/$defs/binding"},
        "manifest_schema": {"$ref": "#/$defs/binding"},
        "runner": {"$ref": "#/$defs/binding"},
        "source_contract": {"$ref": "#/$defs/binding"},
        "source_field_definition": {"$ref": "#/$defs/binding"}
      }
    },
    "archives": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archive_bytes", "archive_sha256", "entry_bytes", "entry_name", "entry_sha256", "exact_contract_rows", "path", "source_url", "year"],
        "properties": {
          "archive_bytes": {"type": "integer", "minimum": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "entry_bytes": {"type": "integer", "minimum": 1},
          "entry_name": {"const": "FinFutYY.txt"},
          "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "exact_contract_rows": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
          "source_url": {"type": "string", "pattern": "^https://www[.]cftc[.]gov/files/dea/history/fut_fin_txt_[0-9]{4}[.]zip$"},
          "year": {"type": "integer", "minimum": 2019, "maximum": 2024}
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
