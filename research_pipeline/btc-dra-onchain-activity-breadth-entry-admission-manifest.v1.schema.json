{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/btc-dra-onchain-activity-breadth-entry-admission-manifest.v1.schema.json",
  "title": "BTC DRA on-chain activity breadth entry-admission manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization", "availability", "bindings", "dataset", "document_type", "economics", "experiment_id", "factor", "gate_set", "oos_access", "parent_strategy", "schema_version", "selection_cutoff", "source", "windows"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "BTC_DRA_ONCHAIN_ACTIVITY_BREADTH_ENTRY_ADMISSION_MANIFEST_V1"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "experiment_id": {"const": "dra-onchain-activity-breadth-entry-admission-historical-v1"},
    "parent_strategy": {"const": "BTC_DRA_V1"},
    "gate_set": {"const": "BTC_DRA_CFTC_TFF_HISTORICAL_ENTRY_ADMISSION_GATES_V1"},
    "oos_access": {"const": "DENY"},
    "selection_cutoff": {"const": "2025-01-01T00:00:00"},
    "dataset": {"const": {"canonical_sha256": "e436a5a2b093365886464dd3e471cc5cd55c54bd2c06ceaa898ac218c45436dd", "rows": 52608}},
    "economics": {"const": {"fee_rate": "0.0010", "initial_equity_usdt": "250", "slippage_rate": "0.0005", "slot_capacity_usdt": "240"}},
    "factor": {
