        "base_runner": {"$ref": "#/$defs/binding"},
        "capacity_runner": {"$ref": "#/$defs/binding"},
        "manifest_schema": {"$ref": "#/$defs/binding"},
        "negative_long_cash_decision": {"$ref": "#/$defs/binding"},
        "normalized_source": {"$ref": "#/$defs/binding"},
        "primary_prior": {"$ref": "#/$defs/binding"},
        "raw_source_response": {"$ref": "#/$defs/binding"},
        "reused_economic_runner": {"$ref": "#/$defs/binding"},
        "runner": {"$ref": "#/$defs/binding"},
        "source_bundle": {"$ref": "#/$defs/binding"},
        "source_metadata": {"$ref": "#/$defs/binding"},
        "source_probe": {"$ref": "#/$defs/binding"}
      }
