{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Research Candidate Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_id",
    "hypothesis",
    "manifest",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "trigger_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "hypothesis": {"type": "object"},
    "manifest": {"type": "object"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"}
  }
}
