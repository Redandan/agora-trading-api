{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/cftc-cme-bitcoin-tff-observation.v1.schema.json",
  "title": "CFTC CME Bitcoin TFF Offline Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "authorization",
    "source_label",
    "source_contract_sha256",
    "source_contract_schema_sha256",
    "observation_schema_sha256",
    "state",
    "expected_report_date",
    "release_proof",
    "scheduled_cycle_at",
    "evaluated_at",
    "state_evidence"
  ],
  "properties": {
    "schema_version": {"const": "CFTC_CME_BITCOIN_TFF_OBSERVATION_V1"},
    "document_type": {"const": "OFFLINE_CFTC_TFF_SOURCE_EVALUATION"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "source_label": {"const": "CFTC_CME_BITCOIN_TFF_FUTURES_ONLY_V1"},
    "source_contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_contract_schema_sha256": {"$ref": "#/$defs/sha256"},
    "observation_schema_sha256": {"$ref": "#/$defs/sha256"},
    "state": {
      "enum": [
        "NO_NEW_REPORT",
        "CONTRACT_ABSENT",
        "DUPLICATE_CONTRACT_ROW",
        "MALFORMED_REPORT",
        "WRONG_REPORT_FAMILY",
        "REPORT_DATE_IN_FUTURE",
        "RELEASE_NOT_DUE",
        "SOURCE_UNAVAILABLE",
        "SAME_REPORT_BYTES_DRIFT",
        "NEW_REPORT_SEALED"
      ]
    },
    "expected_report_date": {"$ref": "#/$defs/day"},
    "release_proof": {"$ref": "#/$defs/releaseProof"},
    "scheduled_cycle_at": {"$ref": "#/$defs/utcTimestamp"},
    "evaluated_at": {"$ref": "#/$defs/utcTimestamp"},
    "state_evidence": {}
  },
  "oneOf": [
    {"properties": {"state": {"const": "NO_NEW_REPORT"}, "state_evidence": {"$ref": "#/$defs/noNewReport"}}},
    {"properties": {"state": {"const": "CONTRACT_ABSENT"}, "state_evidence": {"$ref": "#/$defs/contractAbsent"}}},
    {"properties": {"state": {"const": "DUPLICATE_CONTRACT_ROW"}, "state_evidence": {"$ref": "#/$defs/duplicateContract"}}},
    {"properties": {"state": {"const": "MALFORMED_REPORT"}, "state_evidence": {"$ref": "#/$defs/malformedReport"}}},
    {"properties": {"state": {"const": "WRONG_REPORT_FAMILY"}, "state_evidence": {"$ref": "#/$defs/wrongFamily"}}},
    {"properties": {"state": {"const": "REPORT_DATE_IN_FUTURE"}, "state_evidence": {"$ref": "#/$defs/futureDate"}}},
    {"properties": {"state": {"const": "RELEASE_NOT_DUE"}, "state_evidence": {"$ref": "#/$defs/releaseNotDue"}}},
    {"properties": {"state": {"const": "SOURCE_UNAVAILABLE"}, "state_evidence": {"$ref": "#/$defs/sourceUnavailable"}}},
    {"properties": {"state": {"const": "SAME_REPORT_BYTES_DRIFT"}, "state_evidence": {"$ref": "#/$defs/sameReportDrift"}}},
    {"properties": {"state": {"const": "NEW_REPORT_SEALED"}, "state_evidence": {"$ref": "#/$defs/newReportSealed"}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "offsetTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"},
    "releaseProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_schedule_version",
        "release_schedule_sha256",
        "coverage_start",
        "coverage_end",
        "expected_tuesday",
        "release_at",
        "release_timezone"
      ],
      "properties": {
        "release_schedule_version": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,127}$"},
        "release_schedule_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_start": {"$ref": "#/$defs/day"},
        "coverage_end": {"$ref": "#/$defs/day"},
        "expected_tuesday": {"$ref": "#/$defs/day"},
        "release_at": {"$ref": "#/$defs/offsetTimestamp"},
        "release_timezone": {"const": "America/New_York"}
      }
    },
    "rawSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_response_size_bytes", "raw_response_sha256"],
      "properties": {
        "raw_response_size_bytes": {"type": "integer", "minimum": 0},
        "raw_response_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "recordSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_record_size_bytes",
        "selected_record_sha256",
        "selected_record_terminator",
        "canonical_row_sha256"
      ],
      "properties": {
        "selected_record_size_bytes": {"type": "integer", "minimum": 1},
        "selected_record_sha256": {"$ref": "#/$defs/sha256"},
        "selected_record_terminator": {"enum": ["NONE", "LF", "CRLF", "CR"]},
        "canonical_row_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_and_exchange_names",
        "cftc_contract_market_code",
        "cftc_market_code",
        "cftc_commodity_code",
        "contract_units",
        "cftc_contract_market_code_quotes",
        "cftc_market_code_quotes",
        "cftc_commodity_code_quotes",
        "cftc_subgroup_code",
        "futonly_or_combined"
      ],
      "properties": {
        "market_and_exchange_names": {"const": "BITCOIN - CHICAGO MERCANTILE EXCHANGE"},
        "cftc_contract_market_code": {"const": "133741"},
        "cftc_market_code": {"type": "string", "minLength": 1},
        "cftc_commodity_code": {"type": "string", "minLength": 1},
        "contract_units": {"type": "string", "minLength": 1},
        "cftc_contract_market_code_quotes": {"const": "133741"},
        "cftc_market_code_quotes": {"type": "string", "minLength": 1},
        "cftc_commodity_code_quotes": {"type": "string", "minLength": 1},
        "cftc_subgroup_code": {"type": "string", "minLength": 1},
        "futonly_or_combined": {"const": "FutOnly"}
      }
    },
    "decisionSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule_id", "schedule_version", "schedule_sha256", "decision_at"],
      "properties": {
        "schedule_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,127}$"},
        "schedule_version": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,127}$"},
        "schedule_sha256": {"$ref": "#/$defs/sha256"},
        "decision_at": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "noNewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_date", "raw_seal", "record_seal", "row_identity", "prior_chain_sha256"],
      "properties": {
        "report_date": {"$ref": "#/$defs/day"},
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "record_seal": {"$ref": "#/$defs/recordSeal"},
        "row_identity": {"$ref": "#/$defs/rowIdentity"},
        "prior_chain_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contractAbsent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_seal", "match_count"],
      "properties": {
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "match_count": {"const": 0}
      }
    },
    "duplicateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_seal", "match_count"],
      "properties": {
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "match_count": {"type": "integer", "minimum": 2}
      }
    },
    "malformedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_seal", "reason"],
      "properties": {
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "reason": {
          "enum": [
            "EMPTY_RESPONSE",
            "UTF8_INVALID",
            "CSV_INVALID",
            "HEADER_MISMATCH",
            "FIELD_COUNT_INVALID",
            "DATE_INVALID",
            "DATE_FIELDS_MISMATCH",
            "NON_TUESDAY_REPORT_DATE",
            "UNEXPECTED_REPORT_DATE",
            "REPORT_DATE_REGRESSION"
          ]
        }
      }
    },
    "wrongFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_seal", "record_seal", "reason"],
      "properties": {
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "record_seal": {"$ref": "#/$defs/recordSeal"},
        "reason": {"enum": ["MARKET_IDENTITY_DRIFT", "REPORT_FAMILY_DRIFT", "SECONDARY_IDENTITY_DRIFT"]}
      }
    },
    "futureDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_seal", "record_seal", "observed_report_date"],
      "properties": {
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "record_seal": {"$ref": "#/$defs/recordSeal"},
        "observed_report_date": {"$ref": "#/$defs/day"}
      }
    },
    "releaseNotDue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_at", "first_due_cycle_at"],
      "properties": {
        "release_at": {"$ref": "#/$defs/offsetTimestamp"},
        "first_due_cycle_at": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "sourceUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"const": "NO_RESPONSE_BYTES"}
      }
    },
    "sameReportDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_date",
        "current_raw_seal",
        "current_record_seal",
        "prior_raw_response_sha256",
        "prior_selected_record_sha256",
        "prior_canonical_row_sha256",
        "prior_chain_sha256",
        "integrity_blocked"
      ],
      "properties": {
        "report_date": {"$ref": "#/$defs/day"},
        "current_raw_seal": {"$ref": "#/$defs/rawSeal"},
        "current_record_seal": {"$ref": "#/$defs/recordSeal"},
        "prior_raw_response_sha256": {"$ref": "#/$defs/sha256"},
        "prior_selected_record_sha256": {"$ref": "#/$defs/sha256"},
        "prior_canonical_row_sha256": {"$ref": "#/$defs/sha256"},
        "prior_chain_sha256": {"$ref": "#/$defs/sha256"},
        "integrity_blocked": {"const": true}
      }
    },
    "newReportSealed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_date",
        "received_at",
        "field_count",
        "raw_seal",
        "record_seal",
        "row_identity",
        "predecessor_sha256",
        "decision_schedule",
        "chain_sha256"
      ],
      "properties": {
        "report_date": {"$ref": "#/$defs/day"},
        "received_at": {"$ref": "#/$defs/utcTimestamp"},
        "field_count": {"const": 87},
        "raw_seal": {"$ref": "#/$defs/rawSeal"},
        "record_seal": {"$ref": "#/$defs/recordSeal"},
        "row_identity": {"$ref": "#/$defs/rowIdentity"},
        "predecessor_sha256": {"$ref": "#/$defs/sha256"},
        "decision_schedule": {"$ref": "#/$defs/decisionSchedule"},
        "chain_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
