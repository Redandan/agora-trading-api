        "scheduled_cycle_local_time",
        "scheduled_cycle_semantics",
        "receipt_window",
        "first_eligible_decision"
      ],
      "properties": {
        "release_schedule_proof": {"const": "CALLER_SUPPLIED_IMMUTABLE_VERSION_AND_SHA256"},
        "observation_weekday": {"const": "TUESDAY"},
        "release_timezone": {"const": "America/New_York"},
        "release_local_time": {"const": "15:30:00"},
        "release_lag_calendar_days": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"const": 3},
            "maximum": {"const": 6}
          }
        },
