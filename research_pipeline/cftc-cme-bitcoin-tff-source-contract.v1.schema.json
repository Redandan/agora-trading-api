  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contractSchemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": {"const": "research_pipeline/cftc-cme-bitcoin-tff-source-contract.v1.schema.json"},
        "id": {"const": "https://agora.local/research/cftc-cme-bitcoin-tff-source-contract.v1.schema.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observationSchemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": {"const": "research_pipeline/cftc-cme-bitcoin-tff-observation.v1.schema.json"},
        "id": {"const": "https://agora.local/research/cftc-cme-bitcoin-tff-observation.v1.schema.json"},
