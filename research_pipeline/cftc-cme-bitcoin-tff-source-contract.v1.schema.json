        "observation_document": {"const": "UTF8_COMPACT_SORTED_KEY_JSON"},
        "chain_algorithm": {"const": "SHA-256"},
        "predecessor": {"const": "EXACT_PRIOR_CHAIN_OR_64_ZERO_GENESIS"}
      }
