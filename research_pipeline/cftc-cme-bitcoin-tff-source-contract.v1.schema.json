      "required": [
        "source_registered",
        "producer_implemented",
        "transport_implemented",
        "intake_implemented",
        "capture_authorized",
        "factor_authorized",
        "hypothesis_authorized",
        "candidate_authorized",
        "oos_authorized",
        "trading_authorized",
        "immediate_performance_effect",
        "immediate_drawdown_effect"
