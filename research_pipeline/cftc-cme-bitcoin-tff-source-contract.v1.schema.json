        "scheduled_cycle_semantics": {"const": "FIRST_SOLE_CLOUD_CYCLE_STRICTLY_AFTER_RELEASE"},
        "receipt_window": {"const": "AT_OR_AFTER_SCHEDULED_CYCLE_BEFORE_NEXT_CYCLE"},
        "first_eligible_decision": {"const": "STRICTLY_AFTER_SEALED_RECEIPT"}
