      "type": "object",
      "additionalProperties": false,
      "required": ["states", "same_date_changed_bytes", "alternate_source", "overwrite"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            {"const": "NO_NEW_REPORT"},
            {"const": "CONTRACT_ABSENT"},
            {"const": "DUPLICATE_CONTRACT_ROW"},
            {"const": "MALFORMED_REPORT"},
            {"const": "WRONG_REPORT_FAMILY"},
            {"const": "REPORT_DATE_IN_FUTURE"},
            {"const": "RELEASE_NOT_DUE"},
            {"const": "SOURCE_UNAVAILABLE"},
            {"const": "SAME_REPORT_BYTES_DRIFT"},
            {"const": "NEW_REPORT_SEALED"}
