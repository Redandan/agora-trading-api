      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "observation"],
      "properties": {
        "contract": {"$ref": "#/$defs/contractSchemaBinding"},
        "observation": {"$ref": "#/$defs/observationSchemaBinding"}
      }
