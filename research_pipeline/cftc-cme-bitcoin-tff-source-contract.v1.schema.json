    "sealing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_response",
        "selected_record",
        "canonical_row",
        "observation_document",
        "chain_algorithm",
        "predecessor"
      ],
      "properties": {
        "raw_response": {"const": "BYTE_LENGTH_AND_SHA256_BEFORE_DECODE"},
        "selected_record": {"const": "EXACT_BYTES_WITH_ORIGINAL_TERMINATOR_LENGTH_AND_SHA256"},
