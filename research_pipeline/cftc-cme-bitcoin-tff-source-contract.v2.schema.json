        "field_count": {"const": 87},
        "field_2_grammar": {"const": "YYMMDD_COMPACT/%y%m%d"},
        "field_3_grammar": {"const": "YYYY_DASH_MM_DASH_DD/%Y-%m-%d"},
        "date_equality": {"const": "LOSSLESS_SAME_TUESDAY"},
        "observation_weekday": {"const": "TUESDAY"},
        "target_row": {"const": "EXACTLY_ONE_CONTRACT_CODE_133741"},
        "raw_values": {"const": "PRESERVE_ALL_STRINGS"},
        "suppression_markers": {"const": "PRESERVE_RAW"},
