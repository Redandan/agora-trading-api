        "predecessor": {"const": "EXACT_PRIOR_CHAIN_OR_64_ZERO_GENESIS"}
      }
    },
    "contractSchemaBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {"path": {"const": "research_pipeline/cftc-cme-bitcoin-tff-source-contract.v2.schema.json"}, "id": {"const": "https://agora.local/research/cftc-cme-bitcoin-tff-source-contract.v2.schema.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "observationSchemaBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {"path": {"const": "research_pipeline/cftc-cme-bitcoin-tff-observation.v2.schema.json"}, "id": {"const": "https://agora.local/research/cftc-cme-bitcoin-tff-observation.v2.schema.json"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
