        "release_local_time": {"const": "15:30:00"},
        "release_lag_calendar_days": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"const": 3}, "maximum": {"const": 6}}},
        "cloud_timer_authority": {"const": "CODEX_CLOUD_OPS_ONLY"},
        "cloud_schedule_count": {"const": 1},
