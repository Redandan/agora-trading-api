      "required": ["future_producer", "transport", "canonical_intake", "state_authority", "network_access", "database_access", "registration", "capture"],
      "properties": {
        "future_producer": {"const": "NOT_IMPLEMENTED_FIXED_ZERO_PARAMETER"},
        "transport": {"const": "NOT_IMPLEMENTED_CREATE_ONLY_ONE_WAY_HASH_BOUND"},
        "canonical_intake": {"const": "NOT_IMPLEMENTED_NETWORK_DATABASE_DENIED"},
        "state_authority": {"const": "SERVER_CANONICAL"},
        "network_access": {"const": "DENY_IN_THIS_PACKAGE"},
        "database_access": {"const": "DENY"},
        "registration": {"const": "DENY"},
        "capture": {"const": "DENY"}
      }
