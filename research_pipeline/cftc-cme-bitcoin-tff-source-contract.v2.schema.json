      "required": ["source_registered", "producer_implemented", "transport_implemented", "intake_implemented", "capture_authorized", "factor_authorized", "hypothesis_authorized", "candidate_authorized", "oos_authorized", "trading_authorized", "immediate_performance_effect", "immediate_drawdown_effect"],
      "properties": {
        "source_registered": {"const": false}, "producer_implemented": {"const": false}, "transport_implemented": {"const": false}, "intake_implemented": {"const": false}, "capture_authorized": {"const": false}, "factor_authorized": {"const": false}, "hypothesis_authorized": {"const": false}, "candidate_authorized": {"const": false}, "oos_authorized": {"const": false}, "trading_authorized": {"const": false}, "immediate_performance_effect": {"const": "ZERO"}, "immediate_drawdown_effect": {"const": "ZERO"}
