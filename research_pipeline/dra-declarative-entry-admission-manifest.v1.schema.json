{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/dra-declarative-entry-admission-manifest.v1.schema.json",
  "title": "Declarative DRA entry-admission manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization", "dataset", "document_type", "economics", "experiment_id", "feature", "gate_set", "oos_access", "parent_strategy", "prior_evidence", "schema_version", "selection_cutoff", "variants"],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "DRA_DECLARATIVE_ENTRY_ADMISSION_MANIFEST_V1"},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "parent_strategy": {"const": "BTC_DRA_V1"},
    "selection_cutoff": {"const": "2025-01-01T00:00:00"},
    "oos_access": {"const": "DENY"},
    "gate_set": {"enum": ["DRA_DECLARATIVE_ENTRY_ADMISSION_GATES_V1", "DRA_DECLARATIVE_ENTRY_ADMISSION_GATES_V2"]},
    "prior_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "path", "sha256"],
      "properties": {
        "disposition": {"enum": ["PRIOR_SUPPORTS_ONE_VOLATILITY_MANAGEMENT_DESIGN_AUDIT", "PREREGISTERED_V1_FORWARD_DISCOVERY_MECHANISM", "PRIOR_SUPPORTS_ONE_DOWNSIDE_SEMIVARIANCE_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_AMIHUD_ILLIQUIDITY_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_BIPOWER_JUMPINESS_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_INTRADAY_SIGN_PERSISTENCE_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_DIRECTIONAL_VOLUME_PARTICIPATION_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_INTRADAY_VOLUME_CONCENTRATION_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_US_TRADITIONAL_SESSION_ACTIVITY_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_CLOSE_LOCATION_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_H1_VOLUME_WEIGHTED_CLOSE_LOCATION_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_REALIZED_PERFORMANCE_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_H1_LAG1_RETURN_AUTOCORRELATION_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_INTRADAY_PRICE_PATH_EFFICIENCY_ADMISSION_AUDIT", "PRIOR_SUPPORTS_ONE_WEEKEND_CALENDAR_ADMISSION_AUDIT"]},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_sha256", "rows"],
      "properties": {
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "economics": {
      "type": "object", "additionalProperties": false,
      "required": ["fee_rate", "initial_equity_usdt", "slippage_rate", "slot_capacity_usdt"],
      "properties": {
        "fee_rate": {"const": "0.0010"},
        "initial_equity_usdt": {"const": "250"},
        "slippage_rate": {"const": "0.0005"},
        "slot_capacity_usdt": {"const": "240"}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_time", "key", "lookback_complete_days", "relation"],
      "properties": {
        "decision_time": {"const": "LATEST_COMPLETE_UTC_DAY_BEFORE_NEXT_BAR_FILL"},
        "lookback_complete_days": {"enum": [0, 20]},
        "key": {
          "enum": [
            "LAGGED_DAILY_REALIZED_VOLATILITY_TO_PRIOR_20D_MEDIAN",
            "DAILY_VOLUME_TO_PRIOR_20D_MEDIAN",
            "DAILY_RANGE_PCT_TO_PRIOR_20D_MEDIAN",
            "DAILY_DOWNSIDE_SEMIVARIANCE_SHARE_TO_PRIOR_20D_MEDIAN",
            "DAILY_AMIHUD_ILLIQUIDITY_TO_PRIOR_20D_MEDIAN",
            "DAILY_REALIZED_TO_BIPOWER_VARIATION_RATIO_TO_PRIOR_20D_MEDIAN",
            "DAILY_INTRADAY_SIGN_PERSISTENCE_SHARE_TO_PRIOR_20D_MEDIAN",
            "DAILY_POSITIVE_RETURN_QUOTE_VOLUME_SHARE_TO_PRIOR_20D_MEDIAN",
            "DAILY_QUOTE_VOLUME_HERFINDAHL_TO_PRIOR_20D_MEDIAN",
            "DAILY_1500_2059_UTC_QUOTE_VOLUME_SHARE_TO_PRIOR_20D_MEDIAN",
            "DAILY_CLOSE_LOCATION_VALUE_TO_PRIOR_20D_MEDIAN",
            "DAILY_CLOSE_TO_H1_VOLUME_WEIGHTED_CLOSE_TO_PRIOR_20D_MEDIAN",
            "DAILY_REALIZED_PERFORMANCE_PRIOR_20D_PERCENTILE",
            "DAILY_H1_LAG1_RETURN_AUTOCORRELATION_PRIOR_20D_PERCENTILE",
            "DAILY_INTRADAY_PRICE_PATH_EFFICIENCY_PRIOR_20D_PERCENTILE",
            "LATEST_COMPLETE_UTC_DAY_WEEKDAY_INDEX_MONDAY_ZERO"
          ]
        },
        "relation": {"enum": ["AT_OR_BELOW", "AT_OR_ABOVE"]}
      },
      "allOf": [
        {
          "if": {"properties": {"key": {"enum": ["LAGGED_DAILY_REALIZED_VOLATILITY_TO_PRIOR_20D_MEDIAN", "DAILY_DOWNSIDE_SEMIVARIANCE_SHARE_TO_PRIOR_20D_MEDIAN", "DAILY_AMIHUD_ILLIQUIDITY_TO_PRIOR_20D_MEDIAN", "DAILY_REALIZED_TO_BIPOWER_VARIATION_RATIO_TO_PRIOR_20D_MEDIAN", "DAILY_QUOTE_VOLUME_HERFINDAHL_TO_PRIOR_20D_MEDIAN", "LATEST_COMPLETE_UTC_DAY_WEEKDAY_INDEX_MONDAY_ZERO"]}}},
          "then": {"properties": {"relation": {"const": "AT_OR_BELOW"}}},
          "else": {"properties": {"relation": {"const": "AT_OR_ABOVE"}}}
        },
        {
          "if": {"properties": {"key": {"const": "LATEST_COMPLETE_UTC_DAY_WEEKDAY_INDEX_MONDAY_ZERO"}}, "required": ["key"]},
          "then": {"properties": {"lookback_complete_days": {"const": 0}}},
          "else": {"properties": {"lookback_complete_days": {"const": 20}}}
        }
      ]
    },
    "variants": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "contains": {"type": "object", "properties": {"role": {"const": "primary"}}, "required": ["role"]},
      "minContains": 1, "maxContains": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "threshold", "variant_id"],
        "properties": {
          "role": {"enum": ["lower_neighbor", "primary", "upper_neighbor"]},
          "threshold": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
          "variant_id": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["feature"],
        "properties": {
          "feature": {
            "required": ["key"],
            "properties": {
              "key": {"enum": ["DAILY_1500_2059_UTC_QUOTE_VOLUME_SHARE_TO_PRIOR_20D_MEDIAN", "DAILY_CLOSE_LOCATION_VALUE_TO_PRIOR_20D_MEDIAN", "DAILY_CLOSE_TO_H1_VOLUME_WEIGHTED_CLOSE_TO_PRIOR_20D_MEDIAN", "DAILY_REALIZED_PERFORMANCE_PRIOR_20D_PERCENTILE", "DAILY_H1_LAG1_RETURN_AUTOCORRELATION_PRIOR_20D_PERCENTILE", "DAILY_INTRADAY_PRICE_PATH_EFFICIENCY_PRIOR_20D_PERCENTILE", "LATEST_COMPLETE_UTC_DAY_WEEKDAY_INDEX_MONDAY_ZERO"]}
            }
          }
        }
      },
      "then": {"properties": {"gate_set": {"const": "DRA_DECLARATIVE_ENTRY_ADMISSION_GATES_V2"}}},
      "else": {"properties": {"gate_set": {"const": "DRA_DECLARATIVE_ENTRY_ADMISSION_GATES_V1"}}}
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "repositoryPath": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
