{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/dra-variable-lot-sizing-manifest.v1.schema.json",
  "title": "DRA variable lot sizing manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization",
    "dataset",
    "document_type",
    "economics",
    "experiment_id",
    "feature",
    "forbidden_rescue_actions",
    "gate_contract",
    "gate_set",
    "hypothesis_binding",
    "hypothesis_id",
    "oos_access",
    "parent_strategy",
    "prior_evidence",
    "runner_binding",
    "schema_version",
    "support_runner_binding",
    "variants"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "DRA_VARIABLE_LOT_SIZING_MANIFEST_V1"},
    "experiment_id": {"const": "dra-lagged-realized-variance-scaled-lot-sizing-historical-v1"},
    "hypothesis_id": {"const": "dra-lagged-realized-variance-scaled-lot-sizing-v1"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "parent_strategy": {"const": "BTC_DRA_V1_BASELINE_250_USDT_FIXED_30_USDT_LOTS"},
    "gate_set": {"const": "DRA_VARIABLE_LOT_SIZING_ECONOMIC_GATES_V1"},
    "oos_access": {"const": "DENY"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_sha256", "path", "rows", "selection_cutoff"],
      "properties": {
        "path": {"const": ".research-state/java-parity/selection-2019-2024.tsv"},
        "canonical_sha256": {"const": "e436a5a2b093365886464dd3e471cc5cd55c54bd2c06ceaa898ac218c45436dd"},
        "rows": {"const": 52608},
        "selection_cutoff": {"const": "2025-01-01T00:00:00"}
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adverse_slippage_rate_each_side", "base_lot_cost_usdt", "exit", "fee_rate_each_side", "fill", "initial_equity_usdt", "maximum_open_cost_usdt", "maximum_open_lots"],
      "properties": {
        "initial_equity_usdt": {"const": "250"},
        "maximum_open_cost_usdt": {"const": "240"},
        "maximum_open_lots": {"const": 8},
        "base_lot_cost_usdt": {"const": "30"},
        "fee_rate_each_side": {"const": "0.0010"},
        "adverse_slippage_rate_each_side": {"const": "0.0005"},
        "fill": {"const": "UNCHANGED_NEXT_H1_OPEN"},
        "exit": {"const": "UNCHANGED_DRA_V1_PROFIT_ONLY_5PCT_NET_ESTIMATE"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_time", "key", "mapping", "missing_value", "return"],
      "properties": {
        "key": {"const": "LATEST_COMPLETE_UTC_DAY_REALIZED_VARIANCE_TO_PRIOR_20_COMPLETE_DAY_MEDIAN"},
        "decision_time": {"const": "UNCHANGED_DRA_SIGNAL_AT_COMPLETE_UTC_DAY_23_00_BEFORE_NEXT_H1_OPEN"},
        "return": {"const": "H1_SIMPLE_CLOSE_TO_PREVIOUS_H1_CLOSE"},
        "mapping": {"const": "MAX_FLOOR_MIN_30_30_DIV_NORMALIZED_VARIANCE_RATIO_QUANTIZED_HALF_UP_1E_8"},
        "missing_value": {"const": "UNCHANGED_30_USDT_SIGNAL_PRESERVED"}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/lowerVariant"},
        {"$ref": "#/$defs/primaryVariant"},
        {"$ref": "#/$defs/upperVariant"}
      ],
      "items": false
    },
    "gate_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["each_neighbor_all_required", "failure_disposition", "pass_disposition", "primary_all_required"],
      "properties": {
        "primary_all_required": {"$ref": "#/$defs/primaryGates"},
        "each_neighbor_all_required": {"$ref": "#/$defs/neighborGates"},
        "failure_disposition": {"const": "NO_CANDIDATE_PERMANENTLY_CLOSE_DRA_VARIABLE_LOT_SIZING_FAMILY"},
        "pass_disposition": {"const": "CANDIDATE_FROZEN_REPORTED_NOT_ACTIVATED"}
      }
    },
    "forbidden_rescue_actions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"const": "FORMULA_TUNING_AFTER_OUTCOME"},
        {"const": "FLOOR_TUNING_AFTER_OUTCOME"},
        {"const": "CAP_TUNING_AFTER_OUTCOME"},
        {"const": "GATE_RELAXATION_AFTER_OUTCOME"},
        {"const": "OOS_ACCESS_DURING_HISTORICAL_SCREEN"},
        {"const": "FAMILY_REOPEN_AFTER_FAILED_FROZEN_SCREEN"}
      ],
      "items": false
    },
    "hypothesis_binding": {"$ref": "#/$defs/binding"},
    "prior_evidence": {"$ref": "#/$defs/binding"},
    "runner_binding": {"$ref": "#/$defs/binding"},
    "support_runner_binding": {"$ref": "#/$defs/binding"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lowerVariant": {
      "type": "object", "additionalProperties": false,
      "required": ["floor_usdt", "role", "variant_id"],
      "properties": {
        "role": {"const": "lower_floor_neighbor"},
        "floor_usdt": {"const": "10"},
        "variant_id": {"const": "rv-scaled-new-lot-floor-10-v1"}
      }
    },
    "primaryVariant": {
      "type": "object", "additionalProperties": false,
      "required": ["floor_usdt", "role", "variant_id"],
      "properties": {
        "role": {"const": "primary"},
        "floor_usdt": {"const": "15"},
        "variant_id": {"const": "rv-scaled-new-lot-floor-15-v1"}
      }
    },
    "upperVariant": {
      "type": "object", "additionalProperties": false,
      "required": ["floor_usdt", "role", "variant_id"],
      "properties": {
        "role": {"const": "upper_floor_neighbor"},
        "floor_usdt": {"const": "20"},
        "variant_id": {"const": "rv-scaled-new-lot-floor-20-v1"}
      }
    },
    "primaryGates": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "prefixItems": [
        {"const": "all_variable_sizing_accounting_reconciles"},
        {"const": "design_total_pnl_improves"},
        {"const": "validation_total_pnl_improves"},
        {"const": "design_risk_adjusted_score_improves"},
        {"const": "validation_risk_adjusted_score_improves"},
        {"const": "validation_realized_non_worse"},
        {"const": "validation_unrealized_non_worse"},
        {"const": "validation_drawdown_reduces_at_least_0_25pp"},
        {"const": "validation_max_underwater_duration_non_worse"},
        {"const": "validation_median_hold_non_worse"},
        {"const": "validation_p90_hold_non_worse"},
        {"const": "validation_terminal_inventory_count_non_worse"},
        {"const": "validation_terminal_inventory_cost_non_worse"},
        {"const": "validation_terminal_unrealized_non_worse"},
        {"const": "design_filled_scaled_lots_at_least_8"},
        {"const": "validation_filled_scaled_lots_at_least_4"},
        {"const": "annual_total_wins_at_least_3_of_5"},
        {"const": "annual_drawdown_improves_at_least_4_of_5"},
        {"const": "annual_risk_adjusted_wins_at_least_3_of_5"},
        {"const": "top_year_positive_delta_contribution_at_most_60pct"}
      ],
      "items": false
    },
    "neighborGates": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [
        {"const": "validation_total_pnl_non_worse"},
        {"const": "validation_risk_adjusted_score_non_worse"},
        {"const": "validation_drawdown_strictly_improves"},
        {"const": "validation_realized_non_worse"},
        {"const": "validation_unrealized_non_worse"},
        {"const": "validation_filled_scaled_lots_at_least_4"},
        {"const": "variable_sizing_accounting_reconciles"}
      ],
      "items": false
    }
  }
}
