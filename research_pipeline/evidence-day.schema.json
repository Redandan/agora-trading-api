{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Research Forward Evidence Day",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_type",
    "trigger_id",
    "trigger_fingerprint",
    "source",
    "day",
    "bars",
    "source_provenance",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "bundle_type": {"const": "FORWARD_EVIDENCE_DAY"},
    "trigger_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "trigger_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "string", "minLength": 1},
    "day": {"type": "string", "format": "date"},
    "bars": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interval_start",
          "interval_end",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "properties": {
          "interval_start": {"type": "string", "format": "date-time"},
          "interval_end": {"type": "string", "format": "date-time"},
          "open": {"type": ["string", "number"]},
          "high": {"type": ["string", "number"]},
          "low": {"type": ["string", "number"]},
          "close": {"type": ["string", "number"]},
          "volume": {"type": ["string", "number"]},
          "row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "artifact_id", "sha256"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "received_at": {"type": "string", "format": "date-time"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"}
  }
}
