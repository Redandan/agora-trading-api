{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Research Forward Evidence Source Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_type",
    "trigger_id",
    "trigger_fingerprint",
    "source",
    "producer",
    "transport",
    "artifact_format",
    "worker_network_access",
    "worker_database_access",
    "backfill",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "contract_type": {"const": "FORWARD_EVIDENCE_SOURCE_CONTRACT"},
    "trigger_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "trigger_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "transport": {"type": "string", "minLength": 1},
    "artifact_format": {"const": "FORWARD_EVIDENCE_DAY_V1"},
    "worker_network_access": {"const": "DENY"},
    "worker_database_access": {"const": "DENY"},
    "backfill": {"const": "DENY"},
    "registered_at": {"type": "string", "format": "date-time"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"}
  }
}
