{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/schemas/autonomous-research-hypothesis-v1.json",
  "title": "Autonomous Research Hypothesis V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypothesis_id",
    "title",
    "thesis",
    "mechanism",
    "economic_rationale",
    "source",
    "parent",
    "required_capability",
    "data_readiness",
    "expected_metrics",
    "ranking",
    "research_cycle_id",
    "created_at",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "hypothesis_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "title": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "economic_rationale": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "parent": {"type": "string", "minLength": 1},
    "required_capability": {"type": "string", "minLength": 1},
    "data_readiness": {"enum": ["READY", "MISSING_DATA"]},
    "expected_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_mechanism",
        "interpretability",
        "evidence_readiness",
        "opportunity_cost_reduction"
      ],
      "properties": {
        "economic_mechanism": {"type": "integer", "minimum": 1, "maximum": 5},
        "interpretability": {"type": "integer", "minimum": 1, "maximum": 5},
        "evidence_readiness": {"type": "integer", "minimum": 1, "maximum": 5},
        "opportunity_cost_reduction": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "research_cycle_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"}
  }
}
