{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/local-candidate-enabling-capability.v1.schema.json",
  "title": "Local candidate-enabling capability exception V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization", "capability", "dispatch_id", "dispatch_sha256",
    "document_type", "duplicate_family_key", "exception_id", "intent_id",
    "intent_sha256", "issued_at", "output_class", "rolling_budget",
    "safety_boundaries", "schema_version", "state_authority", "task_id",
    "task_sha256", "timer_authority"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "LOCAL_CANDIDATE_ENABLING_CAPABILITY_V1"},
    "exception_id": {"$ref": "#/$defs/identifier"},
    "issued_at": {"type": "string", "format": "date-time"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "state_authority": {"const": "SERVER_CANONICAL"},
    "timer_authority": {"const": "CODEX_CLOUD_OPS_ONLY"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "task_sha256": {"$ref": "#/$defs/sha256"},
    "dispatch_id": {"$ref": "#/$defs/identifier"},
    "dispatch_sha256": {"$ref": "#/$defs/sha256"},
    "intent_id": {"$ref": "#/$defs/identifier"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "output_class": {"const": "NON_COUNTING"},
    "duplicate_family_key": {"const": "research-factory-candidate-enabling-capability-v1"},
    "rolling_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["days", "maximum_accepted_uses"],
      "properties": {"days": {"const": 7}, "maximum_accepted_uses": {"const": 1}}
    },
    "safety_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["adds_timer", "creates_candidate", "creates_strategy_result", "opens_oos", "trading_action", "uses_paid_api", "writes_canonical_state"],
      "properties": {
        "adds_timer": {"const": false}, "creates_candidate": {"const": false},
        "creates_strategy_result": {"const": false}, "opens_oos": {"const": false},
        "trading_action": {"const": false}, "uses_paid_api": {"const": false},
        "writes_canonical_state": {"const": false}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "capability_kind", "maximum_candidate_variants_per_experiment", "required_economic_outputs", "runner_id", "unlocked_direct_families"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/identifier"},
        "capability_kind": {"const": "DECLARATIVE_DRA_EXPERIMENT_RUNNER"},
        "runner_id": {"$ref": "#/$defs/identifier"},
        "maximum_candidate_variants_per_experiment": {"const": 3},
        "required_economic_outputs": {
          "const": ["adverse_slippage", "drawdown", "fees", "holding_age", "inventory_path", "realized_pnl", "total_pnl", "unrealized_pnl"]
        },
        "unlocked_direct_families": {
          "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["decision_time_availability", "family_key", "feature_family", "matched_comparator_id", "maximum_additional_research_steps", "parent_strategy_id", "positive_next_step", "runner_missing_only"],
            "properties": {
              "decision_time_availability": {"const": "REQUIRED"},
              "family_key": {"$ref": "#/$defs/family"},
              "feature_family": {"$ref": "#/$defs/family"},
              "matched_comparator_id": {"$ref": "#/$defs/identifier"},
              "maximum_additional_research_steps": {"const": 1},
              "parent_strategy_id": {"$ref": "#/$defs/identifier"},
              "positive_next_step": {"const": "FROZEN_HYPOTHESIS_MANIFEST"},
              "runner_missing_only": {"const": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
