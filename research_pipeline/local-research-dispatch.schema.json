{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Codex Research Manager Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "issued_at",
    "manager_thread_id",
    "local_thread_id",
    "task_id",
    "task_sha256",
    "task_type",
    "execution_mode",
    "performance_case",
    "decision_contract",
    "policy_binding",
    "authorization",
    "state_authority",
    "timer_authority"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "dispatch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "manager_thread_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "local_thread_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_type": {
      "enum": [
        "CAPABILITY_READINESS",
        "TOOLING_VERTICAL_SLICE",
        "ADAPTER_IMPLEMENTATION",
        "EVIDENCE_DIAGNOSTIC",
        "REGISTERED_EXPERIMENT_STEP"
      ]
    },
    "execution_mode": {"enum": ["READ_ONLY", "WORKTREE_WRITE"]},
    "performance_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_phase",
        "causal_mechanism",
        "performance_hypothesis",
        "primary_metric",
        "expected_direction",
        "drawdown_hypothesis",
        "opportunity_cost",
        "claim_boundary"
      ],
      "properties": {
        "research_phase": {
          "enum": ["CAPABILITY", "INFRASTRUCTURE", "DIAGNOSTIC", "EXPERIMENT"]
        },
        "causal_mechanism": {"type": "string", "minLength": 20, "maxLength": 2000},
        "performance_hypothesis": {"type": "string", "minLength": 20, "maxLength": 2000},
        "primary_metric": {"const": "fee_adjusted_total_pnl_delta_under_equal_capital"},
        "expected_direction": {
          "enum": ["POSITIVE", "NON_NEGATIVE", "ZERO_IMMEDIATE_EFFECT", "DIAGNOSTIC_ONLY"]
        },
        "drawdown_hypothesis": {"type": "string", "minLength": 20, "maxLength": 2000},
        "opportunity_cost": {"type": "string", "minLength": 20, "maxLength": 2000},
        "claim_boundary": {"type": "string", "minLength": 20, "maxLength": 2000}
      }
    },
    "decision_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_disposition",
        "negative_disposition",
        "insufficient_evidence_disposition",
        "stop_condition_count",
        "stop_conditions_sha256",
        "max_candidate_variants",
        "outcome_tuning",
        "oos_access"
      ],
      "properties": {
        "positive_disposition": {"type": "string", "pattern": "^[A-Z0-9_]{3,100}$"},
        "negative_disposition": {"type": "string", "pattern": "^[A-Z0-9_]{3,100}$"},
        "insufficient_evidence_disposition": {"type": "string", "pattern": "^[A-Z0-9_]{3,100}$"},
        "stop_condition_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "stop_conditions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "max_candidate_variants": {"type": "integer", "minimum": 0, "maximum": 3},
        "outcome_tuning": {"const": "DENY"},
        "oos_access": {"const": "DENY"}
      }
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256", "primary_metric"],
      "properties": {
        "policy_id": {"const": "AUTONOMOUS_TRADING_RESEARCH_V3"},
        "policy_sha256": {"const": "a82ccff13c13765d1e94a29698a43b35b847ed19190965590fa72e9a102981f6"},
        "primary_metric": {"const": "fee_adjusted_total_pnl_delta_under_equal_capital"}
      }
    },
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "state_authority": {"const": "SERVER_CANONICAL"},
    "timer_authority": {"const": "CODEX_CLOUD_OPS_ONLY"}
  }
}
