{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Codex Research Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_sha256",
    "status",
    "authorization",
    "started_at",
    "completed_at",
    "source_git_commit",
    "source_git_dirty_before",
    "source_git_dirty_after",
    "summary",
    "checks",
    "artifacts",
    "files_changed",
    "uncertainty",
    "recommended_next_action",
    "safety_assertions"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["COMPLETED", "BLOCKED", "FAILED"]},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "source_git_commit": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "source_git_dirty_before": {"type": "boolean"},
    "source_git_dirty_after": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z0-9_]{3,100}$"},
          "status": {"enum": ["PASS", "FAIL", "MISSING_PROOF"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 1000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "files_changed": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "uncertainty": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "recommended_next_action": {"type": "string", "minLength": 1, "maxLength": 2000},
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_state_changed",
        "server_research_mcp_write_attempted",
        "second_timer_created",
        "trading_action_attempted",
        "oos_opened",
        "paid_api_used"
      ],
      "properties": {
        "canonical_state_changed": {"const": false},
        "server_research_mcp_write_attempted": {"const": false},
        "second_timer_created": {"const": false},
        "trading_action_attempted": {"const": false},
        "oos_opened": {"const": false},
        "paid_api_used": {"const": false}
      }
    }
  }
}
