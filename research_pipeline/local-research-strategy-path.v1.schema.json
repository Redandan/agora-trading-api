{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Research Direct Strategy Path V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "admission_id",
    "issued_at",
    "manager_thread_id",
    "task_id",
    "task_sha256",
    "dispatch_id",
    "dispatch_sha256",
    "intent_id",
    "intent_sha256",
    "output_class",
    "decision_time",
    "candidate_path",
    "economics",
    "disposition",
    "authorization",
    "state_authority",
    "timer_authority"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "document_type": {"const": "LOCAL_RESEARCH_STRATEGY_PATH_V1"},
    "admission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "manager_thread_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dispatch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "dispatch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "intent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_class": {"const": "MECHANISM_CONCLUSION"},
    "decision_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability_status", "feature_name", "availability_rule", "decision_clock", "post_outcome_dependency"],
      "properties": {
        "availability_status": {"const": "KNOWN_BEFORE_DECISION"},
        "feature_name": {"type": "string", "minLength": 3, "maxLength": 200},
        "availability_rule": {"type": "string", "minLength": 20, "maxLength": 1000},
        "decision_clock": {"type": "string", "minLength": 3, "maxLength": 200},
        "post_outcome_dependency": {"const": "DENY"}
      }
    },
    "candidate_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "parent_strategy_id", "matched_comparator_id", "positive_next_step", "maximum_additional_research_steps", "existing_adapter_or_direct_runner", "implementation_before_economic_test"],
      "properties": {
        "status": {"enum": ["DIRECT_TO_FROZEN_HYPOTHESIS", "DIRECT_TO_MATCHED_CAPITAL_EXPERIMENT"]},
        "parent_strategy_id": {"type": "string", "minLength": 3, "maxLength": 200},
        "matched_comparator_id": {"type": "string", "minLength": 3, "maxLength": 200},
        "positive_next_step": {"enum": ["FROZEN_HYPOTHESIS_MANIFEST", "MATCHED_CAPITAL_EXPERIMENT"]},
        "maximum_additional_research_steps": {"type": "integer", "minimum": 0, "maximum": 1},
        "existing_adapter_or_direct_runner": {"const": true},
        "implementation_before_economic_test": {"const": "DENY"}
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equal_capital_comparator_required", "fees_required", "adverse_slippage_required", "total_pnl_required", "drawdown_required", "inventory_path_required", "holding_age_required"],
      "properties": {
        "equal_capital_comparator_required": {"const": true},
        "fees_required": {"const": true},
        "adverse_slippage_required": {"const": true},
        "total_pnl_required": {"const": true},
        "drawdown_required": {"const": true},
        "inventory_path_required": {"const": true},
        "holding_age_required": {"const": true}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["negative_closes_family", "insufficient_stops_without_permission", "independent_forward_or_oos_boundary_preserved"],
      "properties": {
        "negative_closes_family": {"const": true},
        "insufficient_stops_without_permission": {"const": true},
        "independent_forward_or_oos_boundary_preserved": {"const": true}
      }
    },
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "state_authority": {"const": "SERVER_CANONICAL"},
    "timer_authority": {"const": "CODEX_CLOUD_OPS_ONLY"}
  }
}
