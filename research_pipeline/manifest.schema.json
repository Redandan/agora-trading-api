{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/schemas/autonomous-research-manifest-v1.json",
  "title": "Autonomous Research Experiment Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "thesis",
    "economic_rationale",
    "hypothesis_source",
    "parent",
    "adapter",
    "created_at",
    "selection_cutoff",
    "max_variants",
    "authorization",
    "objective"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "title": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1},
    "economic_rationale": {"type": "string", "minLength": 1},
    "hypothesis_source": {"type": "string", "minLength": 1},
    "parent": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["legacy-v12", "legacy-v3g-diagnostic", "flat-veto-cooldown-v2b", "java-dra-v1-parity", "java-dra-v1-economic-ledger", "one-slot-signal-rotation-v1", "dra-forward-entry-admission-v1"]},
    "created_at": {"type": "string", "format": "date-time"},
    "selection_cutoff": {"type": "string", "format": "date-time"},
    "oos_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "max_variants": {"type": "integer", "minimum": 1, "maximum": 3},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "adapter_config": {"type": "object"},
    "objective": {
      "type": "object",
      "required": ["primary_metric"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
