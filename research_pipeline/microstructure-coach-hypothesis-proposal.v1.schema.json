{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agora-research:microstructure-coach-hypothesis-proposal:v1",
  "title": "OKX Microstructure Coach Hypothesis Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_type",
    "authorization",
    "source_interpretation",
    "coach_proposal",
    "safety_assertions",
    "seal"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "proposal_type": {"const": "OKX_MICROSTRUCTURE_COACH_HYPOTHESIS_PROPOSAL_V1"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "source_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "document_sha256",
        "payload_sha256",
        "disposition",
        "selected_tier"
      ],
      "properties": {
        "result_type": {"const": "OKX_MICROSTRUCTURE_FORWARD_INTERPRETATION_RESULT_V1"},
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "disposition": {"const": "READY_FOR_ONE_HYPOTHESIS_DESIGN"},
        "selected_tier": {
          "enum": [
            "MIDLINE_RATIO_1_5_ONLY",
            "MIDLINE_RATIO_1_5_PLUS_NET_TAKER_BUY",
            "MIDLINE_RATIO_1_5_PLUS_NET_TAKER_BUY_PLUS_BOOK_SUPPORT"
          ]
        }
      }
    },
    "coach_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_id",
        "created_at",
        "title",
        "thesis",
        "economic_rationale",
        "performance_thesis",
        "drawdown_thesis",
        "opportunity_cost"
      ],
      "properties": {
        "design_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string", "minLength": 1},
        "thesis": {"type": "string", "minLength": 1},
        "economic_rationale": {"type": "string", "minLength": 1},
        "performance_thesis": {"type": "string", "minLength": 1},
        "drawdown_thesis": {"type": "string", "minLength": 1},
        "opportunity_cost": {"type": "string", "minLength": 1}
      }
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_registration_authorized",
        "oos_access_authorized",
        "activation_authorized",
        "second_timer_or_writer_authorized",
        "trading_database_order_fund_action_authorized",
        "paid_api_authorized"
      ],
      "properties": {
        "hypothesis_registration_authorized": {"const": false},
        "oos_access_authorized": {"const": false},
        "activation_authorized": {"const": false},
        "second_timer_or_writer_authorized": {"const": false},
        "trading_database_order_fund_action_authorized": {"const": false},
        "paid_api_authorized": {"const": false}
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payload_sha256", "canonicalization"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonicalization": {
          "const": "UTF-8 compact JSON excluding seal; object keys sorted lexicographically"
        }
      }
    }
  }
}
