{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agora-research:microstructure-hypothesis-design-result:v1",
  "title": "OKX Microstructure Hypothesis Design Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_type",
    "authorization",
    "design_contract",
    "source_interpretation",
    "source_disposition",
    "status",
    "hypothesis_design",
    "policy_binding",
    "evidence_plan",
    "missing_proof",
    "safety_assertions",
    "seal"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "result_type": {"const": "OKX_MICROSTRUCTURE_HYPOTHESIS_DESIGN_RESULT_V1"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "design_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "sha256"],
      "properties": {
        "contract_id": {"const": "OKX_MICROSTRUCTURE_HYPOTHESIS_DESIGN_V1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_interpretation": {"$ref": "#/$defs/source_interpretation"},
    "source_disposition": {
      "enum": [
        "READY_FOR_ONE_HYPOTHESIS_DESIGN",
        "NO_CANDIDATE_SHORT_HORIZON_BUY_PRESSURE",
        "AMBIGUOUS_NO_HYPOTHESIS",
        "INSUFFICIENT_FORWARD_EVIDENCE"
      ]
    },
    "status": {
      "enum": ["CLOSED_NO_HYPOTHESIS_DESIGN", "DESIGN_ONLY_NOT_REGISTERED"]
    },
    "hypothesis_design": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/hypothesis_design"}
      ]
    },
    "policy_binding": {"$ref": "#/$defs/policy_binding"},
    "evidence_plan": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/evidence_plan"}
      ]
    },
    "missing_proof": {"$ref": "#/$defs/missing_proof"},
    "safety_assertions": {"$ref": "#/$defs/safety_assertions"},
    "seal": {"$ref": "#/$defs/seal"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "result_schema_sha256",
        "document_sha256",
        "payload_sha256",
        "contract_id",
        "contract_sha256",
        "handoff_document_sha256",
        "handoff_payload_sha256",
        "diagnostic_contract_id",
        "diagnostic_contract_sha256",
        "diagnostic_payload_sha256",
        "diagnostic_document_sha256",
        "selected_tier"
      ],
      "properties": {
        "result_type": {"const": "OKX_MICROSTRUCTURE_FORWARD_INTERPRETATION_RESULT_V1"},
        "result_schema_sha256": {"$ref": "#/$defs/sha256"},
        "document_sha256": {"$ref": "#/$defs/sha256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "contract_id": {"const": "OKX_MICROSTRUCTURE_FORWARD_INTERPRETATION_V1"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_document_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_payload_sha256": {"$ref": "#/$defs/sha256"},
        "diagnostic_contract_id": {"const": "OKX_MICROSTRUCTURE_FORWARD_DIAGNOSTIC_V3"},
        "diagnostic_contract_sha256": {"$ref": "#/$defs/sha256"},
        "diagnostic_payload_sha256": {"$ref": "#/$defs/sha256"},
        "diagnostic_document_sha256": {"$ref": "#/$defs/sha256"},
        "selected_tier": {
          "oneOf": [
            {"type": "null"},
            {
              "enum": [
                "MIDLINE_RATIO_1_5_ONLY",
                "MIDLINE_RATIO_1_5_PLUS_NET_TAKER_BUY",
                "MIDLINE_RATIO_1_5_PLUS_NET_TAKER_BUY_PLUS_BOOK_SUPPORT"
              ]
            }
          ]
        }
      }
    },
    "hypothesis_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_id",
        "created_at",
        "title",
        "thesis",
        "economic_rationale",
        "performance_thesis",
        "drawdown_thesis",
        "opportunity_cost",
        "proposed_parent",
        "required_capability",
        "proposed_mechanism",
        "maximum_candidate_variants"
      ],
      "properties": {
        "design_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string", "minLength": 1},
        "thesis": {"type": "string", "minLength": 1},
        "economic_rationale": {"type": "string", "minLength": 1},
        "performance_thesis": {"type": "string", "minLength": 1},
        "drawdown_thesis": {"type": "string", "minLength": 1},
        "opportunity_cost": {"type": "string", "minLength": 1},
        "proposed_parent": {
          "const": {
            "key": "BTC_DRA_V1_BASELINE_250_USDT_RESEARCH",
            "status": "PROPOSED_PENDING_CLOCK_AND_FEATURE_COMPATIBILITY"
          }
        },
        "required_capability": {
          "const": "DRA_MICROSTRUCTURE_ENTRY_ADMISSION_ADAPTER_V1_NOT_IMPLEMENTED"
        },
        "proposed_mechanism": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism_id",
            "source_selected_tier",
            "direction",
            "threshold_tuning_authorized",
            "magnitude_claim_authorized",
            "more_complex_tier_selection_authorized"
          ],
          "properties": {
            "mechanism_id": {"const": "DRA_SELECTED_MICROSTRUCTURE_TIER_ENTRY_ADMISSION_V1"},
            "source_selected_tier": {
              "enum": [
                "MIDLINE_RATIO_1_5_ONLY",
                "MIDLINE_RATIO_1_5_PLUS_NET_TAKER_BUY",
                "MIDLINE_RATIO_1_5_PLUS_NET_TAKER_BUY_PLUS_BOOK_SUPPORT"
              ]
            },
            "direction": {"const": "ENTRY_ADMISSION_ONLY"},
            "threshold_tuning_authorized": {"const": false},
            "magnitude_claim_authorized": {"const": false},
            "more_complex_tier_selection_authorized": {"const": false}
          }
        },
        "maximum_candidate_variants": {"const": 1}
      }
    },
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256", "primary_metric", "required_metrics", "constraints"],
      "properties": {
        "policy_id": {"const": "AUTONOMOUS_TRADING_RESEARCH_V3"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "primary_metric": {"const": "fee_adjusted_total_pnl_delta_under_equal_capital"},
        "required_metrics": {
          "const": [
            "realized_pnl",
            "unrealized_pnl",
            "total_pnl",
            "maximum_drawdown",
            "capital_utilization",
            "blocked_entries",
            "holding_age"
          ]
        },
        "constraints": {
          "const": [
            "causal_point_in_time_data",
            "positive_incremental_validation_and_oos_evidence",
            "no_material_drawdown_deterioration",
            "no_hidden_terminal_inventory_loss",
            "stable_neighboring_behavior",
            "year_and_regime_concentration_visible"
          ]
        }
      }
    },
    "evidence_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_window_role",
        "discovery_window_reuse_as_oos",
        "hypothesis_and_manifest_freeze_before_future_oos_start",
        "future_candidate_oos_window",
        "exact_oos_dates",
        "required_future_evaluations"
      ],
      "properties": {
        "discovery_window_role": {"const": "DISCOVERY_ONLY_NOT_OOS"},
        "discovery_window_reuse_as_oos": {"const": false},
        "hypothesis_and_manifest_freeze_before_future_oos_start": {"const": true},
        "future_candidate_oos_window": {"const": "SEPARATELY_FROZEN_AFTER_DESIGN_AND_MANIFEST"},
        "exact_oos_dates": {"const": "MISSING_PROOF_PENDING_CANONICAL_REGISTRATION"},
        "required_future_evaluations": {
          "const": [
            "realized_pnl",
            "unrealized_pnl",
            "total_pnl",
            "drawdown_path",
            "capital_utilization",
            "blocked_entries",
            "holding_age",
            "year_and_regime_breadth",
            "terminal_inventory",
            "fees",
            "slippage",
            "fills",
            "capacity"
          ]
        }
      }
    },
    "missing_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_pnl",
        "drawdown",
        "capital_utilization",
        "holding_risk",
        "fees_slippage_fills_capacity",
        "dra_clock_compatibility",
        "adapter_readiness",
        "candidate_readiness",
        "oos_value"
      ],
      "properties": {
        "strategy_pnl": {"const": "MISSING_PROOF"},
        "drawdown": {"const": "MISSING_PROOF"},
        "capital_utilization": {"const": "MISSING_PROOF"},
        "holding_risk": {"const": "MISSING_PROOF"},
        "fees_slippage_fills_capacity": {"const": "MISSING_PROOF"},
        "dra_clock_compatibility": {"const": "MISSING_PROOF"},
        "adapter_readiness": {"const": "MISSING_PROOF"},
        "candidate_readiness": {"const": "MISSING_PROOF"},
        "oos_value": {"const": "MISSING_PROOF"}
      }
    },
    "safety_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_state_write_authorized",
        "research_state_write_authorized",
        "candidate_registration_authorized",
        "oos_access_authorized",
        "activation_authorized",
        "second_timer_or_writer_authorized",
        "trading_database_order_fund_action_authorized",
        "paid_api_authorized"
      ],
      "properties": {
        "canonical_state_write_authorized": {"const": false},
        "research_state_write_authorized": {"const": false},
        "candidate_registration_authorized": {"const": false},
        "oos_access_authorized": {"const": false},
        "activation_authorized": {"const": false},
        "second_timer_or_writer_authorized": {"const": false},
        "trading_database_order_fund_action_authorized": {"const": false},
        "paid_api_authorized": {"const": false}
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payload_sha256", "canonicalization"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "canonicalization": {"const": "UTF-8 compact JSON excluding seal; object keys sorted lexicographically"}
      }
    }
  }
}
