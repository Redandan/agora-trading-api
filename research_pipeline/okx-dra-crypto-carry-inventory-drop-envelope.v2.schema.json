{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agora.local/research/okx-dra-crypto-carry-inventory-drop-envelope.v2.schema.json",
  "title": "OKX DRA Crypto Carry Inventory-Only Drop Envelope V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_type", "authorization", "status", "phase", "source_label", "source_contract_sha256", "producer_envelope_schema_sha256", "inventory_drop_schema_sha256", "source_identity", "source_group", "intake_identity", "target_day", "published_at", "files", "delivery_semantics", "reservation_name", "idempotency_key", "envelope_seal"],
  "properties": {
    "schema_version": {"const": "OKX_DRA_CRYPTO_CARRY_INVENTORY_DROP_ENVELOPE_V2"},
    "envelope_type": {"const": "IMMUTABLE_ONE_WAY_DRA_CRYPTO_CARRY_INVENTORY_ONLY"},
    "authorization": {"const": "RESEARCH_ONLY_NOT_SHADOW_PAPER_OR_LIVE"},
    "status": {"const": "OFFLINE_DISABLED_NOT_DEPLOYED"},
    "phase": {"const": "PREPARE_INVENTORY"},
    "source_label": {"const": "LAGGED_OKX_BTC_USDT_EXPIRY_FUTURES_BASIS_ATOMS_V1"},
    "source_contract_sha256": {"$ref": "#/$defs/sha256"},
    "producer_envelope_schema_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_drop_schema_sha256": {"$ref": "#/$defs/sha256"},
    "source_identity": {"const": "agora-dra-carry-source"},
    "source_group": {"const": "agora-dra-carry-publish"},
    "intake_identity": {"const": "agora-research"},
    "target_day": {"$ref": "#/$defs/day"},
    "published_at": {"$ref": "#/$defs/timestamp"},
    "files": {"$ref": "#/$defs/files"},
    "delivery_semantics": {"$ref": "#/$defs/delivery"},
    "reservation_name": {"type": "string", "pattern": "^\\.[0-9]{4}-[0-9]{2}-[0-9]{2}\\.inventory-v2\\.publish-reserved$"},
    "idempotency_key": {"type": "string", "pattern": "^DRA_CRYPTO_CARRY_V2:INVENTORY:[0-9]{4}-[0-9]{2}-[0-9]{2}:[0-9a-f]{64}$"},
    "envelope_seal": {"$ref": "#/$defs/seal"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "hash_scope"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "hash_scope": {"enum": ["FULL_FILE_BYTES", "CANONICAL_PAYLOAD_EXCLUDING_SELF_DESCRIPTOR_AND_ENVELOPE_SEAL"]}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory", "v2_parent_envelope", "inventory_drop_envelope"],
      "properties": {
        "inventory": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"name": {"pattern": "^okx-dra-crypto-carry-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.inventory\\.json$"}, "hash_scope": {"const": "FULL_FILE_BYTES"}}}]},
        "v2_parent_envelope": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"name": {"pattern": "^okx-dra-crypto-carry-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.inventory-parent-v2\\.json$"}, "hash_scope": {"const": "FULL_FILE_BYTES"}}}]},
        "inventory_drop_envelope": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"name": {"pattern": "^okx-dra-crypto-carry-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.inventory-drop-v2\\.json$"}, "hash_scope": {"const": "CANONICAL_PAYLOAD_EXCLUDING_SELF_DESCRIPTOR_AND_ENVELOPE_SEAL"}}}]}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "phase", "atomic_rename", "overwrite", "publisher_read_after_publish", "symlinks", "existing_roots_only", "same_filesystem", "reservation_required", "intake_network_access", "intake_write_access", "canonical_state_access", "retry", "backfill"],
      "properties": {
        "transport": {"const": "DRA_CRYPTO_CARRY_V2_CREATE_ONLY_ATOMIC_ONE_WAY_DROP"},
        "phase": {"const": "PREPARE_INVENTORY"},
        "atomic_rename": {"const": true}, "overwrite": {"const": false}, "publisher_read_after_publish": {"const": false}, "symlinks": {"const": false}, "existing_roots_only": {"const": true}, "same_filesystem": {"const": true}, "reservation_required": {"const": true}, "intake_network_access": {"const": false}, "intake_write_access": {"const": false}, "canonical_state_access": {"const": false}, "retry": {"const": false}, "backfill": {"const": false}
      }
    },
    "seal": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "payload_sha256", "canonicalization", "sealed_at"],
      "properties": {"algorithm": {"const": "SHA-256"}, "payload_sha256": {"$ref": "#/$defs/sha256"}, "canonicalization": {"const": "UTF-8 compact sorted-key JSON excluding files.inventory_drop_envelope and envelope_seal"}, "sealed_at": {"$ref": "#/$defs/timestamp"}}
    }
  }
}
