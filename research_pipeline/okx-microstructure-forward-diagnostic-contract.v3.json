    "overlapping_horizon_labels_allowed": true,
    "overlap_must_be_reported": true
  },
  "entry_reference": {
    "timing": "NEXT_COMPLETE_MINUTE_OPEN",
    "field": "trade_open_price",
    "signal_minute_price_is_prohibited": true
  },
  "response": {
    "horizons_minutes": [
      5,
      15,
      60,
      240,
      1440
    ],
    "metrics": [
      "return_bps",
      "mfe_bps",
      "mae_bps",
