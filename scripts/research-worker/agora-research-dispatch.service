[Unit]
Description=Run one queued fixed Agora research-control operation
Documentation=file:/opt/agora-research-worker/control-current/docs/server-research-worker-v2.md
After=local-fs.target
StartLimitIntervalSec=8h
StartLimitBurst=3

[Service]
Type=oneshot
User=agora-research
Group=agora-research
SupplementaryGroups=agora-evidence
WorkingDirectory=/opt/agora-research-worker/control-current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AGORA_RESEARCH_STATE_DIR=/var/lib/agora-research/state
Environment=AGORA_RESEARCH_INBOX_DIR=/var/lib/agora-research/inbox
Environment=AGORA_RESEARCH_REQUEST_DIR=/var/lib/agora-research/requests
Environment=AGORA_RESEARCH_POLICY_FILE=/opt/agora-research-worker/control-current/research_pipeline/policy.v3.json
Environment=APP_DIR=/opt/agora-research-worker/control-current
ExecStart=/opt/agora-research-worker/control-current/scripts/research-worker/run-request.sh
RuntimeDirectory=agora-research
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/agora-research/okx-microstructure-continuous-source-v3r1.json
ReadWritePaths=/var/lib/agora-research /run/agora-research
InaccessiblePaths=-/etc/agora-research/okx-microstructure-continuous-source-v1.json -/etc/agora-research/okx-microstructure-continuous-source-v3.json -/var/lib/agora-evidence-source -/home/ubuntu/.env.trading.secrets
CapabilityBoundingSet=
SystemCallArchitectures=native
TimeoutStartSec=2h15min
Restart=on-abnormal
RestartSec=5s
