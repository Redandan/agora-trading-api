[Unit]
Description=Agora deterministic autonomous research heartbeat
Documentation=file:/opt/agora-research-worker/current/docs/server-research-worker-v2.md
After=local-fs.target

[Service]
Type=oneshot
User=agora-research
Group=agora-research
WorkingDirectory=/opt/agora-research-worker/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AGORA_RESEARCH_STATE_DIR=/var/lib/agora-research/state
Environment=AGORA_RESEARCH_INBOX_DIR=/var/lib/agora-research/inbox
Environment=AGORA_RESEARCH_POLICY_FILE=/opt/agora-research-worker/current/research_pipeline/policy.v3.json
ExecStart=/opt/agora-research-worker/current/scripts/research-worker/run-heartbeat.sh
RuntimeDirectory=agora-research
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/agora-research /run/agora-research
CapabilityBoundingSet=
SystemCallArchitectures=native
TimeoutStartSec=2h15min

[Install]
WantedBy=multi-user.target
