[Unit]
Description=Agora research microstructure V3 handoff exporter
Documentation=file:/opt/agora-research-worker/control-current/docs/server-research-worker-v2.md
After=local-fs.target

[Service]
Type=oneshot
User=agora-research
Group=agora-research
SupplementaryGroups=agora-evidence
WorkingDirectory=/opt/agora-research-worker/control-current
ExecStart=/opt/agora-research-worker/venv/bin/python -m research_pipeline.microstructure_handoff_export
Restart=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ReadOnlyPaths=/etc/agora-research/okx-microstructure-continuous-source-v3.json
ReadOnlyPaths=/var/lib/agora-research/state/microstructure-v3
ReadOnlyPaths=/var/lib/agora-evidence-source/microstructure-drop
ReadOnlyPaths=/etc/agora-research/local-tasks/microstructure-v3-evidence-diagnostic.v1.json
ReadOnlyPaths=/opt/agora-research-worker/current
ReadOnlyPaths=/opt/agora-research-worker/control-current
ReadWritePaths=/var/lib/agora-research/microstructure-v3-handoff-staging
ReadWritePaths=/var/lib/agora-research/microstructure-v3-handoff-export
InaccessiblePaths=/home/ubuntu/.env.trading.secrets
SystemCallArchitectures=native
TimeoutStartSec=5min
