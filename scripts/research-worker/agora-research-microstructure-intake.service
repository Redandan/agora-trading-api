[Unit]
Description=Agora research microstructure canonical intake
After=local-fs.target
ConditionPathIsDirectory=/var/lib/agora-evidence-source/microstructure-drop
ConditionPathIsDirectory=/var/lib/agora-research/state/microstructure-v3

[Service]
Type=oneshot
User=agora-research
Group=agora-research
WorkingDirectory=/opt/agora-research-worker/current
ExecStart=/opt/agora-research-worker/venv/bin/python -m research_pipeline.microstructure_intake_cli ingest-v3
Restart=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ReadOnlyPaths=/etc/agora-research/okx-microstructure-continuous-source-v3.json
ReadOnlyPaths=/opt/agora-research-worker/current
ReadWritePaths=/var/lib/agora-evidence-source/microstructure-drop
ReadWritePaths=/var/lib/agora-research/state/microstructure-v3
InaccessiblePaths=/var/lib/agora-research/state/microstructure
InaccessiblePaths=/var/lib/agora-research/state/authority.json
InaccessiblePaths=/var/lib/agora-research/source-drop
InaccessiblePaths=/home/ubuntu/.env.trading.secrets
