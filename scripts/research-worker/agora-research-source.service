[Unit]
Description=Capture one fixed public OKX forward-evidence day
Documentation=file:/opt/agora-research-worker/current/docs/server-forward-evidence-source-v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agora-evidence-source
Group=agora-evidence
WorkingDirectory=/opt/agora-research-worker/current
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AGORA_RESEARCH_SOURCE_REQUEST_DIR=/var/lib/agora-research/source-requests
Environment=AGORA_RESEARCH_SOURCE_DROP_DIR=/var/lib/agora-research/source-drop
ExecStart=/opt/agora-research-worker/venv/bin/python -m research_source source
Restart=on-failure
RestartSec=60
SuccessExitStatus=65
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/var/lib/agora-research/state /var/lib/agora-research/requests /var/lib/agora-research/auth /var/lib/agora-research/inbox
ReadWritePaths=/var/lib/agora-research/source-requests /var/lib/agora-research/source-drop
CapabilityBoundingSet=
SystemCallArchitectures=native
TimeoutStartSec=5min
